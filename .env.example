SECRET_KEY=django-insecure-change-me
# Прод: DEBUG=0, вписать внешний IP/домен VPS через запятую.
DEBUG=1
ALLOWED_HOSTS=127.0.0.1,localhost
# DB_ENGINE=sqlite  # либо postgres + DB_NAME/DB_USER/DB_PASSWORD/DB_HOST/DB_PORT
# SESSION_COOKIE_AGE=31536000  # год по умолчанию, как в settings.py
# SQLite для MVP лежит в db.sqlite3 — бэкапить файл регулярно.
# Пуши (FCM): выключены по умолчанию. Для включения положить service account
# JSON только на сервер (в репозиторий и архив не класть) и выставить:
# PUSH_ENABLED=1
# FIREBASE_CREDENTIALS_FILE=/home/clinic/clinic_schedule/.firebase-service.json
# FIREBASE_PROJECT_ID=your-firebase-project
# Свой Celery только для расписания (очередь не трогаем):
# CELERY_BROKER_URL=redis://127.0.0.1:6379/10
# CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/10
# CELERY_TASK_ALWAYS_EAGER=0  # в тестах можно 1
